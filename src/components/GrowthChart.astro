---

<section class="section" id="growth" style="border-bottom:none;">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="section-tag">05 &mdash; Track Record</div>
        <h2>Asset Under Management</h2>
      </div>
      <p>patokan kurs yang dipakai $1 = Rp17.550</p>
    </div>

    <div class="ladder-wrap reveal">
      <div class="growth-chart shimmer-card">
        <svg id="growthSvg" viewBox="0 0 940 380" preserveAspectRatio="none">
          <defs>
            <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#E8112D" stop-opacity="0.35"></stop>
              <stop offset="100%" stop-color="#E8112D" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <line x1="0" y1="60" x2="940" y2="60" class="grid-line"></line>
          <line x1="0" y1="140" x2="940" y2="140" class="grid-line"></line>
          <line x1="0" y1="220" x2="940" y2="220" class="grid-line"></line>
          <line x1="0" y1="300" x2="940" y2="300" class="grid-line"></line>

          <path id="growthArea" class="growth-area" d="M0,344 L150,332 L300,300 L450,254 L600,236 L720,80 L840,190 L840,380 L0,380 Z"></path>
          <path id="growthLine" class="growth-line" d="M0,344 L150,332 L300,300 L450,254 L600,236 L720,80 L840,190"></path>

          <g class="grid-labels">
            <text x="868" y="52" class="grid-label">$45.6K</text>
            <text x="868" y="132" class="grid-label">$28.5K</text>
            <text x="868" y="212" class="grid-label">$14.3K</text>
            <text x="868" y="292" class="grid-label">$5.7K</text>
          </g>

          <g class="growth-points">
            <circle cx="840" cy="190" r="6" class="point-pulse"></circle>
            <circle cx="840" cy="190" r="5.5" class="point-final"></circle>
          </g>
        </svg>
        <div class="growth-labels">
          <div><span class="gl-age">15</span><span class="gl-val">&lt;$600</span></div>
          <div><span class="gl-age">16</span><span class="gl-val">&gt;$850</span></div>
          <div><span class="gl-age">17</span><span class="gl-val">&gt;$2,850</span></div>
          <div><span class="gl-age">18</span><span class="gl-val">$4,560</span></div>
          <div><span class="gl-age">19</span><span class="gl-val">$5,700</span></div>
          <div><span class="gl-age">20</span><span class="gl-val gl-highlight">&gt;$17,100</span></div>
        </div>
      </div>
      <p class="ladder-note">
        angka diatas merupakan pembulatan aset untuk kebutuhan ilustasi, data diambil berdasarkan hisotry nyata perjalanan wealth personal
      </p>
    </div>
  </div>
</section>

<script>
  import { initGrowthReveal } from "../scripts/growthReveal";
  initGrowthReveal();
</script>
