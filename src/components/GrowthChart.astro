---
---

<section class="section" id="growth" style="border-bottom:none;">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="section-tag">05 &mdash; Track Record</div>
        <h2>Progres nilai kekayaan berdasarkan usia</h2>
      </div>
      <p>
        Setiap baris merepresentasikan estimasi total aset yang dikelola pada usia tersebut
        &mdash; dibangun bertahap, tanpa jalan pintas.
      </p>
    </div>

    <div class="ladder-wrap reveal">
      <div class="growth-chart shimmer-card">
        <svg id="growthSvg" viewBox="0 0 940 380" preserveAspectRatio="none">
          <defs>
            <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#E8112D" stop-opacity="0.35"></stop>
              <stop offset="100%" stop-color="#E8112D" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <line x1="0" y1="60" x2="940" y2="60" class="grid-line"></line>
          <line x1="0" y1="140" x2="940" y2="140" class="grid-line"></line>
          <line x1="0" y1="220" x2="940" y2="220" class="grid-line"></line>
          <line x1="0" y1="300" x2="940" y2="300" class="grid-line"></line>

          <path id="growthArea" class="growth-area" d="M0,344 L164,332 L328,300 L492,254 L656,236 L940,20 L940,380 L0,380 Z"></path>
          <path id="growthLine" class="growth-line" d="M0,344 L164,332 L328,300 L492,254 L656,236 L940,20"></path>

          <g class="growth-points">
            <circle cx="0" cy="344" r="5"></circle>
            <circle cx="164" cy="332" r="5"></circle>
            <circle cx="328" cy="300" r="5"></circle>
            <circle cx="492" cy="254" r="5"></circle>
            <circle cx="656" cy="236" r="5"></circle>
            <circle cx="940" cy="20" r="5.5" class="point-final"></circle>
          </g>
        </svg>
        <div class="growth-labels">
          <div><span class="gl-age">15</span><span class="gl-val">&lt;Rp10jt</span></div>
          <div><span class="gl-age">16</span><span class="gl-val">&gt;Rp15jt</span></div>
          <div><span class="gl-age">17</span><span class="gl-val">&gt;Rp50jt</span></div>
          <div><span class="gl-age">18</span><span class="gl-val">Rp80jt</span></div>
          <div><span class="gl-age">19</span><span class="gl-val">Rp100jt</span></div>
          <div><span class="gl-age">20</span><span class="gl-val gl-highlight">&gt;Rp1M</span></div>
        </div>
      </div>
      <p class="ladder-note">
        Angka merepresentasikan estimasi total nilai aset yang dikelola pada tiap usia,
        dibulatkan untuk keperluan ilustrasi. Bukan merupakan jaminan hasil di masa depan
        &mdash; performa pasar saham dan kripto bersifat fluktuatif.
      </p>
    </div>
  </div>
</section>

<script>
  import { initGrowthReveal } from "../scripts/growthReveal";
  initGrowthReveal();
</script>
