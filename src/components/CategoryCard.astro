---
import type { Holding } from "../data/portfolio";

interface Props {
  title: string;
  holdings: Holding[];
}

const { title, holdings } = Astro.props;
---

<div class="category-card reveal">
  <h3 class="category-title">{title}</h3>
  <div class="asset-list">
    {
      holdings.map((h) => (
        <button
          type="button"
          class="asset-chip"
          data-symbol={h.symbol}
          data-name={h.name}
          data-category={h.category}
          data-desc={h.desc}
          data-icon={h.icon}
          data-sparkline={h.sparkline}
          aria-haspopup="dialog"
        >
          <img class="asset-icon" src={h.icon} alt="" loading="lazy" width="36" height="36" />
          <span class="asset-text">
            <span class="asset-name">{h.name}</span>
            <span class="asset-symbol">{h.symbol}</span>
          </span>
        </button>
      ))
    }
  </div>
</div>
