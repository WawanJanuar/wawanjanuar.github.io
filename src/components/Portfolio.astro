---
import { holdings } from "../data/portfolio";
import CategoryCard from "./CategoryCard.astro";
import AssetModal from "./AssetModal.astro";

const digitalAssets = holdings.filter((h) => h.category === "Digital Asset");
const cash = holdings.filter((h) => h.category === "Cash");
---

<section class="section" id="portfolio">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="section-tag">03 &mdash; Portfolio</div>
        <h2>Aset inti yang sedang dikelola</h2>
      </div>
      <p>
        Posisi utama yang mencerminkan keyakinan jangka panjang kami saat ini, lintas pasar
        saham, aset kripto, dan cadangan tunai. Klik tiap aset untuk detailnya.
      </p>
    </div>

    <div class="category-grid">
      <CategoryCard title="Cryptocurrency" holdings={digitalAssets} />
      <CategoryCard title="Cash" holdings={cash} />
    </div>
  </div>
</section>

<AssetModal />

<script>
  import { initSpotlight } from "../scripts/spotlight";
  import { initPortfolioModal } from "../scripts/portfolioModal";
  initSpotlight();
  initPortfolioModal();
</script>
