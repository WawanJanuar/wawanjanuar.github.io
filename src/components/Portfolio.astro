---
import { holdings } from "../data/portfolio";
import PortfolioCard from "./PortfolioCard.astro";
---

<section class="section" id="portfolio">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="section-tag">03 &mdash; Portfolio</div>
        <h2>Aset inti yang sedang dikelola</h2>
      </div>
      <p>
        Posisi utama yang mencerminkan keyakinan jangka panjang kami saat ini, lintas pasar
        saham, aset kripto, dan cadangan tunai.
      </p>
    </div>

    <div class="ticker-grid ticker-grid-6">
      {holdings.map((holding) => <PortfolioCard holding={holding} />)}
    </div>
  </div>
</section>

<script>
  import { initSpotlight } from "../scripts/spotlight";
  import { initPortfolioReveal } from "../scripts/portfolioReveal";
  initSpotlight();
  initPortfolioReveal();
</script>
