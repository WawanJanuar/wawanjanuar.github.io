---
const year = new Date().getFullYear();

const navLinks = [
  { label: "Thesis", href: "#thesis" },
  { label: "Portfolio", href: "#portfolio" },
  { label: "Founder", href: "#founder" },
  { label: "Growth", href: "#growth" },
];
---

<footer class="wrap footer-new">
  <div class="foot-brand">
    <div class="foot-logo">
      <img src="/assets/logo-cw.png" alt="Capital Wawan" />
    </div>
    <span class="foot-copy">&copy; {year} Capital Wawan</span>
  </div>
  <div class="foot-col">
    <div class="foot-col-title">Navigasi</div>
    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </div>
  <div class="foot-col">
    <div class="foot-col-title">Kontak</div>
    <a href="https://www.instagram.com/wawanjanuarr/" target="_blank" rel="noopener">Instagram</a>
  </div>
</footer>
